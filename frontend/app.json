{
  "expo": {
    "name": "Hairpin",
    "slug": "convoy",
    "version": "3.4.0",
    "orientation": "portrait",
    "icon": "./assets/HAIRPIN.png",
    "scheme": "convoy",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": "1.20.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sw0rdfisch.convoy",
      "buildNumber": "68",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.sw0rdfisch.convoy"
        ]
      },
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSAppleMusicUsageDescription": "Play and control Apple Music right inside Hairpin",
        "NSLocationWhenInUseUsageDescription": "Show nearby drivers and hazards on the map",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Keep the convoy live in the background",
        "NSMicrophoneUsageDescription": "Push-to-talk and voice commands",
        "NSCameraUsageDescription": "Add photos of your car to your garage",
        "NSSpeechRecognitionUsageDescription": "Voice activation for hands-free driving",
        "UIBackgroundModes": [
          "audio",
          "location",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.sw0rdfisch.convoy",
      "versionCode": 68,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/hairpin-adaptive.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.661488764764-6t8fkojm7gnkdjfp6k83dbnbnrjchtt3"
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Keep navigation directions live in the background while a route is active."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2DEC86"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "extraPods": [
              {
                "name": "AppAuth",
                "modular_headers": true
              },
              {
                "name": "GTMAppAuth",
                "modular_headers": true
              },
              {
                "name": "GTMSessionFetcher",
                "modular_headers": true
              },
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              },
              {
                "name": "AppCheckCore",
                "modular_headers": true
              }
            ]
          },
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      "./plugins/withConvoyAndroidAuto.js",
      "./plugins/withConvoyCarPlay.js",
      "./plugins/withScoutSiri.js",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e72b32e-e0c5-4126-b590-ea2ec6e596e1"
      }
    },
    "owner": "sw0rdfisch",
    "updates": {
      "url": "https://u.expo.dev/1e72b32e-e0c5-4126-b590-ea2ec6e596e1",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 15000
    }
  }
}
