+    // Convoy: SF-symbol map buttons. [RCTConvert UIImage:] resolves RN asset
+    // dicts through the LEGACY bridge image loader, which returns nil under
+    // bridgeless New Arch — and CarPlay renders NOTHING for a CPMapButton whose
+    // image is nil (why the police/Scout-mic map buttons "never rendered" on
+    // builds 61-64). UIImage systemImageNamed: needs no bridge at all, so it
+    // works everywhere. Takes precedence over a (probably-nil) custom image.
+    if ([json objectForKey:@"systemImage"]) {
+        UIImage *sysImg = [UIImage systemImageNamed:[RCTConvert NSString:json[@"systemImage"]]];
+        if (sysImg) { [mapButton setImage:sysImg]; }
+    }
+
