+            // Attaching to a joined/joining channel is benign here: the callback simply
+            // starts receiving events from the next sync/message on.
+            this.socket.log('channel', `cannot add \`${type}\` callbacks for ${this.topic} after \`subscribe()\`. (Convoy patch: attaching anyway instead of throwing)`);
